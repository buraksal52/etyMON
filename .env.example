# Shared/local defaults
APP_ENV=development
APP_URL=http://localhost:3000
EVENT_TIMEZONE=event-local

# FastAPI / Railway API
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL
DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/platform

# Object storage (Railway Storage Bucket or another S3-compatible provider)
STORAGE_PROVIDER=railway
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

# Monad / rewards (configured in a later phase)
MONAD_RPC_URL=
MONAD_CHAIN_ID=
REWARD_POOL_CONTRACT_ADDRESS=
REWARD_SIGNER_PRIVATE_KEY=

# Organizer (configured in a later phase)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
